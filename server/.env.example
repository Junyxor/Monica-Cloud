## Monica Cloud configuration. Copy to `.env` (or pass as environment variables).
## Every value below is the default.

## Public URL, used in share links and shown to clients.
# DOMAIN=https://cloud.example.com

# ADDRESS=0.0.0.0
# PORT=8000

## Database, signing key and encrypted blobs live here. Back this folder up.
# DATA_FOLDER=data
# DATABASE_URL=data/db.sqlite3

## Built WebUI (webui/dist). Set WEB_VAULT_ENABLED=false to serve only the API.
# WEB_VAULT_FOLDER=web-vault
# WEB_VAULT_ENABLED=true

## The first account can always register and becomes the owner.
## These two can also be changed at runtime in Administration → Server.
# SIGNUPS_ALLOWED=true
# SENDS_ALLOWED=true
## Comma separated; empty allows every domain.
# SIGNUPS_DOMAINS_WHITELIST=

## Default per-user storage quota for attachments and Send files (empty = unlimited).
# USER_QUOTA_MB=
# ATTACHMENT_MAX_MB=100
# JSON_LIMIT_MB=32

## PBKDF2-SHA256 iterations for new accounts (100000-2000000).
# KDF_ITERATIONS_DEFAULT=600000
# ACCESS_TOKEN_TTL_SECS=7200
## Devices idle longer than this must log in again.
# REFRESH_TOKEN_DAYS=90

## Client IP header when running behind a reverse proxy; `none` uses the socket address.
# IP_HEADER=X-Real-IP
# LOGIN_RATELIMIT_PER_MINUTE=10

# EVENT_RETENTION_DAYS=365
# TOMBSTONE_RETENTION_DAYS=180
# LOG_LEVEL=info
